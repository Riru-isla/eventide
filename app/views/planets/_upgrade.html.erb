<% definition = structure.definition %>
<% cost = structure.upgrade_cost %>
<% next_level = structure.level + 1 %>
<% affordable = economy.affordable?(structure) %>
<% balance_after = economy.energy_balance_after_upgrade(structure) %>
<% tips_into_deficit = balance_after.negative? && !economy.deficit? %>

<section class="mod" aria-label="Upgrade">
  <div class="mod-head">
    <h2 class="mod-title">Upgrade</h2>
    <span class="mod-note"><%= definition.name %> → <%= next_level %></span>
  </div>

  <div class="flex flex-col gap-4 p-4">
    <p class="font-sans text-[0.8125rem] text-ink-2"><%= definition.summary %></p>

    <dl class="flex flex-col">
      <% [
           [ "Metal", number_with_delimiter(cost[:metal]), (empire.metal >= cost[:metal] ? "text-metal" : "text-bad") ],
           [ "Crystal", number_with_delimiter(cost[:crystal]), (empire.crystal >= cost[:crystal] ? "text-crystal" : "text-bad") ],
           [ "Energy balance after", number_with_sign(balance_after), (balance_after.negative? ? "text-bad" : "text-good") ]
         ].each do |term, value, tone| %>
        <div class="flex justify-between gap-3 border-b border-line-soft py-2 text-[0.8125rem] last:border-b-0">
          <dt class="text-ink-3"><%= term %></dt>
          <dd class="num <%= tone %>"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <% if tips_into_deficit %>
      <p class="font-sans text-[0.8125rem] text-bad">
        This tips <%= @planet.name %> into deficit. Extraction drops to
        <%= (PlanetEconomy::THROTTLE * 100).round %>% until the Solar Array catches up.
      </p>
    <% end %>

    <%= button_to "Upgrade to #{next_level}",
                  planet_structure_path(structure.kind),
                  method: :patch,
                  disabled: !affordable,
                  class: "btn w-full",
                  form_class: "w-full" %>

    <% unless affordable %>
      <p class="label">Not enough resources</p>
    <% end %>
  </div>
</section>
