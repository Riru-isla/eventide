<% production = economy.energy_production %>
<% consumption = economy.energy_consumption %>
<% balance = economy.energy_balance %>
<% scale = [ production, consumption, 1 ].max.to_f %>

<section class="mod" aria-label="Energy balance">
  <div class="mod-head">
    <h2 class="mod-title">Energy bus</h2>
    <span class="mod-note">Production vs draw</span>
  </div>

  <div class="p-4">
    <div class="mb-3.5 flex items-end justify-between gap-4">
      <span class="num text-[2.5rem] font-bold leading-none <%= balance.negative? ? "text-bad" : "text-good" %>">
        <%= number_with_sign(balance) %>
      </span>
      <span class="text-right text-[0.6875rem] uppercase tracking-[0.18em] <%= balance.negative? ? "text-bad" : "text-good" %>">
        <%= balance.negative? ? "Deficit · throttled" : "Surplus · nominal" %>
      </span>
    </div>

    <div class="bar">
      <div class="bar-fill" style="width: <%= (production / scale * 100).round(2) %>%"></div>
      <% if balance.negative? %>
        <div class="bar-over"
             style="left: <%= (production / scale * 100).round(2) %>%; width: <%= ((consumption - production) / scale * 100).round(2) %>%"></div>
      <% end %>
      <div class="bar-draw" style="left: <%= (consumption / scale * 100).round(2) %>%"></div>
    </div>

    <div class="num mt-2 flex justify-between text-[0.6875rem] tracking-[0.06em] text-ink-3">
      <span>Produced <b class="text-ink-2"><%= number_with_delimiter(production) %></b></span>
      <span>Drawn <b class="text-ink-2"><%= number_with_delimiter(consumption) %></b></span>
    </div>

    <% if balance.negative? %>
      <ul class="mt-4 border-t border-line-soft">
        <% [
             [ "Resource extraction", "−#{((1 - PlanetEconomy::THROTTLE) * 100).round}%", false ],
             [ "Energy buildings", "exempt", true ]
           ].each do |label, value, exempt| %>
          <li class="flex justify-between gap-3 border-b border-line-soft py-2 text-[0.8125rem] last:border-b-0">
            <span class="text-ink-2"><%= label %></span>
            <span class="num <%= exempt ? "text-good" : "text-bad" %>"><%= value %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
