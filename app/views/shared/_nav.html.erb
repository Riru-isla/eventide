<%# Overview, Resources and Facilities are views onto the current planet; Research is
    empire-wide. Sections that do not exist yet are shown disabled rather than hidden,
    so the shape of the game stays visible while it gets built out. %>
<% sections = [
     { key: :overview,   label: "Overview",   path: planet_path },
     { key: :resources,  label: "Resources",  path: planet_structures_path(section: "resources") },
     { key: :facilities, label: "Facilities", path: planet_structures_path(section: "facilities") },
     { key: :research,   label: "Research" },
     { key: :shipyard,   label: "Shipyard" },
     { key: :fleet,      label: "Fleet" },
     { key: :galaxy,     label: "Galaxy",     path: Galaxy.first && galaxy_path(Galaxy.first) }
   ] %>

<nav aria-label="Sections">
  <ul class="flex flex-col gap-px max-lg:flex-row max-lg:flex-wrap">
    <% sections.each do |section| %>
      <li>
        <% if section[:path] %>
          <%= link_to section[:path],
                      class: "nav-item",
                      "aria-current": (section[:key] == current ? "page" : nil) do %>
            <span class="nav-dot"></span><%= section[:label] %>
          <% end %>
        <% else %>
          <span class="nav-item" aria-disabled="true" title="Not built yet">
            <span class="nav-dot"></span><%= section[:label] %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
