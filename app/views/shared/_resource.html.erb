<div class="flex items-center gap-2.5">
  <svg class="size-[22px] flex-none" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <% if glyph == :metal %>
      <path d="M12 3 20 8v8l-8 5-8-5V8z" stroke="#a9b6cc" stroke-width="1.4"/>
      <path d="M12 8.5 16 11v4l-4 2.5L8 15v-4z" fill="#a9b6cc" opacity=".35"/>
    <% elsif glyph == :crew %>
      <circle cx="12" cy="7.5" r="3.2" stroke="#57be8e" stroke-width="1.4"/>
      <path d="M5 20.5c0-3.6 3.1-6.2 7-6.2s7 2.6 7 6.2" stroke="#57be8e" stroke-width="1.4"/>
    <% else %>
      <path d="M12 2.5 19 9l-7 12.5L5 9z" stroke="#79d2e2" stroke-width="1.4"/>
      <path d="M12 2.5 12 21.5M5 9h14" stroke="#79d2e2" stroke-width="1.1" opacity=".45"/>
    <% end %>
  </svg>

  <span class="flex flex-col leading-tight">
    <span class="num text-[0.9375rem] font-semibold <%= full ? "text-bad" : tone %>">
      <%= number_with_delimiter(amount) %>
    </span>
    <span class="num text-[0.6875rem] <%= full ? "text-bad" : "text-ink-3" %>">
      <% if full %>
        storage full
      <% elsif rate %>
        <%= number_with_sign(rate) %> <%= unit %>
      <% end %>
      <span class="text-ink-3">· <%= number_to_human(capacity, units: { thousand: "k", million: "M" }, precision: 2, strip_insignificant_zeros: true) %> cap</span>
    </span>
  </span>
</div>
