<div class="max-w-md mx-auto mt-20 bg-gray-900 rounded-lg p-8">
  <h1 class="text-3xl font-bold text-white mb-2">Eventide</h1>
  <p class="text-gray-400 mb-6">Log in to command your empire.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :username, class: "block text-sm text-gray-400 mb-1" %>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "w-full bg-gray-800 text-white rounded px-3 py-2", placeholder: "ada" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm text-gray-400 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full bg-gray-800 text-white rounded px-3 py-2" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center text-sm text-gray-400">
        <%= f.check_box :remember_me, class: "mr-2" %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded" %>
  <% end %>

  <p class="mt-4 text-sm text-gray-400 text-center">
    New commander?
    <%= link_to "Create an empire", new_registration_path(resource_name), class: "text-blue-400 hover:text-blue-300" %>
  </p>
</div>
