<div class="max-w-md mx-auto mt-20 bg-gray-900 rounded-lg p-8">
  <h1 class="text-3xl font-bold text-white mb-2">Join Eventide</h1>
  <p class="text-gray-400 mb-6">Create your commander and empire.</p>

  <% if flash[:alert] %>
    <div class="bg-red-900/50 text-red-200 px-4 py-3 rounded mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with model: @player, url: users_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Commander Name", class: "block text-sm text-gray-400 mb-1" %>
      <%= f.text_field :name, class: "w-full bg-gray-800 text-white rounded px-3 py-2", placeholder: "Ada Lovelace" %>
    </div>

    <div>
      <%= f.label :username, "Username", class: "block text-sm text-gray-400 mb-1" %>
      <%= f.text_field :username, class: "w-full bg-gray-800 text-white rounded px-3 py-2", placeholder: "ada" %>
    </div>

    <div>
      <%= f.label :password, "Password", class: "block text-sm text-gray-400 mb-1" %>
      <%= f.password_field :password, class: "w-full bg-gray-800 text-white rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm text-gray-400 mb-1" %>
      <%= f.password_field :password_confirmation, class: "w-full bg-gray-800 text-white rounded px-3 py-2" %>
    </div>

    <div>
      <%= label_tag "empire[role]", "Empire Role", class: "block text-sm text-gray-400 mb-1" %>
      <%= select_tag "empire[role]",
                     options_for_select([
                       [ "Cultivator — crystal bonus, specialized harvesters", "cultivator" ],
                       [ "Foundry — metal bonus, heavy dreadnoughts", "foundry" ],
                       [ "Warden — energy bonus, durable carriers", "warden" ]
                     ]),
                     class: "w-full bg-gray-800 text-white rounded px-3 py-2" %>
      <p class="text-xs text-gray-500 mt-1">Your role determines resource bonuses and unlocks specialized ships.</p>
    </div>

    <%= f.submit "Create Empire", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded" %>
  <% end %>

  <p class="mt-4 text-sm text-gray-400 text-center">
    Already have an account?
    <%= link_to "Log in", new_session_path, class: "text-blue-400 hover:text-blue-300" %>
  </p>
</div>
