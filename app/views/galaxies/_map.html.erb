<section class="mod" aria-label="Galaxy map">
  <div class="mod-head">
    <h2 class="mod-title"><%= galaxy.name %></h2>
    <span class="mod-note">
      <%= number_with_delimiter(galaxy.width) %>&times;<%= number_with_delimiter(galaxy.height) %> ·
      Tick <%= number_with_delimiter(galaxy.current_tick) %>
    </span>
  </div>

  <div class="relative aspect-square w-full">
    <%# turbo-permanent so a tick refresh does not redraw a few thousand stars. %>
    <canvas id="galaxy-render"
            class="absolute inset-0 h-full w-full"
            data-controller="galaxy-render"
            data-turbo-permanent
            aria-hidden="true"></canvas>

    <svg viewBox="0 0 <%= GalaxiesHelper::MAP_VIEWBOX %> <%= GalaxiesHelper::MAP_VIEWBOX %>"
         class="absolute inset-0 h-full w-full"
         role="img"
         aria-label="Held sectors of <%= galaxy.name %>">
      <% sectors.each do |sector| %>
        <% x, y = sector_position(sector, galaxy) %>
        <% colour = sector_color(sector, empire_colors) %>

        <% if sector.kind == "core" %>
          <circle cx="<%= x %>" cy="<%= y %>" r="22" fill="none"
                  stroke="#ef4444" stroke-width="1.5" opacity="0.45" />
        <% end %>

        <circle class="sector"
                cx="<%= x %>" cy="<%= y %>" r="<%= sector_radius(sector) %>"
                fill="<%= colour %>">
          <title><%= sector.name %> (<%= sector.coordinate %>) — <%= sector.owner_name %></title>
        </circle>
      <% end %>
    </svg>
  </div>

  <p class="border-t border-line-soft px-4 py-3 font-sans text-[0.8125rem] text-ink-2">
    Showing the <%= number_with_delimiter(sectors.size) %> sectors somebody holds, out of
    <%= number_with_delimiter(galaxy.width * galaxy.height) %>. Empty space is not drawn.
  </p>
</section>
