<% content_for :title, "#{@galaxy.name} — Eventide" %>

<div class="mt-5 grid items-start gap-5 lg:grid-cols-[148px_minmax(0,1fr)]">

  <%= render "shared/nav", current: :galaxy %>

  <main class="grid min-w-0 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_320px]">
    <%= render "galaxies/map", galaxy: @galaxy, empire_colors: @empire_colors %>

    <div class="flex flex-col gap-5">
      <%= render "galaxies/roster", empires: @empires, empire_colors: @empire_colors, galaxy: @galaxy %>
    </div>
  </main>
</div>
