<div class="max-w-md mx-auto mt-20 bg-gray-900 rounded-lg p-8">
  <h1 class="text-3xl font-bold text-white mb-2">Eventide</h1>
  <p class="text-gray-400 mb-6">Choose your empire to continue.</p>

  <% if flash[:alert] %>
    <div class="bg-red-900/50 text-red-200 px-4 py-3 rounded mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: session_path, class: "space-y-4" do |f| %>
    <%= f.hidden_field :galaxy_id, value: @galaxy.id %>

    <div>
      <%= f.label :empire_id, "Empire", class: "block text-sm text-gray-400 mb-1" %>
      <%= f.select :empire_id,
                   @galaxy.empires.includes(:player).map { |e| [ "#{e.player.name} (#{e.role})", e.id ] },
                   { prompt: "Select your empire" },
                   class: "w-full bg-gray-800 text-white rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password, "Password", class: "block text-sm text-gray-400 mb-1" %>
      <%= f.password_field :password,
                           class: "w-full bg-gray-800 text-white rounded px-3 py-2",
                           placeholder: "default: eventide" %>
    </div>

    <%= f.submit "Enter", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded" %>
  <% end %>
</div>
