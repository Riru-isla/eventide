<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Eventide" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Eventide">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# A tick refresh morphs the page in place rather than replacing it, so the
        player keeps their scroll position and whatever they were reading. %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-ground text-ink font-mono">
    <%# turbo-permanent: a morph must not touch the canvas, or the starfield is wiped
        every tick — its pixels are not in the DOM for morphing to restore. %>
    <canvas id="starfield" class="fixed inset-0 -z-10 pointer-events-none" aria-hidden="true"
            data-controller="starfield" data-turbo-permanent></canvas>

    <% if user_signed_in? && current_empire.present? %>
      <%# Every tick broadcasts a refresh to this stream, so queues, research and
          resources stop going stale between page loads. %>
      <%= turbo_stream_from current_empire.galaxy %>
      <%= render "shared/hud", empire: current_empire %>
    <% end %>

    <div class="relative mx-auto w-full max-w-[1280px] px-5 pb-16">
      <%= render "shared/flash" %>

      <%= yield %>
    </div>
  </body>
</html>
