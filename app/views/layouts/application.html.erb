<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Eventide" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Eventide">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-ground text-ink font-mono">
    <canvas id="starfield" class="fixed inset-0 -z-10 pointer-events-none" aria-hidden="true"
            data-controller="starfield"></canvas>

    <% if user_signed_in? && current_empire.present? %>
      <%= render "shared/hud", empire: current_empire %>
    <% end %>

    <div class="relative mx-auto w-full max-w-[1280px] px-5 pb-16">
      <% if flash.any? %>
        <div class="flex flex-col gap-2 pt-4">
          <% flash.each do |type, message| %>
            <p class="flash flash-<%= type == "notice" ? "notice" : "alert" %>"><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
