<% content_for :title, "Shipyard — Eventide" %>

<div class="mt-5 grid items-start gap-5 lg:grid-cols-[148px_minmax(0,1fr)]">

  <%= render "shared/nav", current: :shipyard %>

  <main class="min-w-0">
    <%= turbo_frame_tag "planet-main", class: "flex flex-col gap-5" do %>
      <%= render "shipyard/yard", planet: @planet, shipyard: @shipyard, empire: @empire %>
    <% end %>
  </main>
</div>
